# Copy to .env and adjust for this project. Never put passwords, wallets,
# tokens, or credential-bearing URLs here; SQLcl owns connection credentials.
PROJECT_NAME=example
DB_TARGET_SCHEMA=EXAMPLE
APEX_APP_ID=100
APEX_APP_SLUG=example-app
SQLCL_CONNECTION=dev1_EXAMPLE
DB_ENVIRONMENT=development
DB_EXPECTED_USER=EXAMPLE
DB_REQUIRED_ROLE=NONE

# When true, agents may use the install-uc-apx skill to install the optional
# CLI (with approval) and synchronize its skills into this project.
INSTALL_UC_APX=false
UC_APX_SKILLS_AGENT=universal
