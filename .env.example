# Copy this file to .env and adjust the values for one project environment.
# Never store passwords, wallets, tokens, or credential-bearing URLs here.

# Purpose: Human-readable project name used by agents and project documentation.
# Example: PROJECT_NAME=inventory-portal
PROJECT_NAME=example

# Purpose: Safety classification used by database guards and production notices.
# Example: DB_ENVIRONMENT=development
DB_ENVIRONMENT=development

# Purpose: One or more APEX application IDs exported from the configured parsing schema.
# Example: APEX_APP_ID=100,200
APEX_APP_ID=100,200

# Purpose: Oracle schema that owns the tables selected for metadata backup.
# Example: TABLES_SCHEMA=EXAMPLE_DATA
TABLES_SCHEMA=EXAMPLE_DATA

# Purpose: Object-name prefixes included in the table metadata export.
# Examples: TABLES_PREFIXES=APP_,COMMON_ or TABLES_PREFIXES=*
TABLES_PREFIXES=EXAMPLE_,COMMON_

# Purpose: SQLcl saved-connection alias for table metadata reads; this is not a connection string or credential.
# Example: TABLES_SQLCL_CONNECTION=dev1_EXAMPLE_DATA
TABLES_SQLCL_CONNECTION=dev1_EXAMPLE_DATA

# Purpose: Oracle SESSION_USER expected after opening the tables saved connection; this verifies identity and grants nothing.
# Example: TABLES_EXPECTED_USER=EXAMPLE_DATA
TABLES_EXPECTED_USER=EXAMPLE_DATA

# Purpose: Oracle schema that owns views, packages, procedures, functions, and triggers selected for backup.
# Example: CODE_SCHEMA=EXAMPLE_CODE
CODE_SCHEMA=EXAMPLE_CODE

# Purpose: Object-name prefixes included in the code metadata export.
# Examples: CODE_PREFIXES=APP_,COMMON_ or CODE_PREFIXES=*
CODE_PREFIXES=EXAMPLE_,COMMON_

# Purpose: SQLcl saved-connection alias for code metadata reads; this is not a connection string or credential.
# Example: CODE_SQLCL_CONNECTION=dev1_EXAMPLE_CODE
CODE_SQLCL_CONNECTION=dev1_EXAMPLE_CODE

# Purpose: Oracle SESSION_USER expected after opening the code saved connection; this verifies identity and grants nothing.
# Example: CODE_EXPECTED_USER=EXAMPLE_CODE
CODE_EXPECTED_USER=EXAMPLE_CODE

# Purpose: Oracle parsing schema that owns the configured APEX applications.
# Example: APEX_PARSING_SCHEMA=EXAMPLE
APEX_PARSING_SCHEMA=EXAMPLE

# Purpose: SQLcl saved-connection alias for APEX exports; this is not a connection string or credential.
# Example: APEX_SQLCL_CONNECTION=dev1_EXAMPLE
APEX_SQLCL_CONNECTION=dev1_EXAMPLE

# Purpose: Oracle SESSION_USER expected after opening the APEX saved connection; this verifies identity and grants nothing.
# Example: APEX_EXPECTED_USER=EXAMPLE
APEX_EXPECTED_USER=EXAMPLE

# Purpose: Whether agents may use the project skill to install optional uc-apx tooling.
# Example: INSTALL_UC_APX=false
INSTALL_UC_APX=false

# Purpose: Agent target used when uc-apx skills are synchronized; allowed values are universal or claude-code.
# Example: UC_APX_SKILLS_AGENT=universal
UC_APX_SKILLS_AGENT=universal
